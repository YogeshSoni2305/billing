generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  default_rate Float
  active       Boolean  @default(true)
}

model Bill {
  id            Int        @id @default(autoincrement())
  bill_number   String     @unique
  request_id    String     @unique
  timestamp     DateTime   @default(now())
  customer_name String?
  total_amount  Float
  status        String     @default("COMPLETED")
  items         BillItem[]
}

model BillItem {
  id           Int    @id @default(autoincrement())
  bill_id      Int
  product_name String
  quantity     Int
  rate         Float
  amount       Float
  bill         Bill   @relation(fields: [bill_id], references: [id])
}

model SystemConfig {
  key   String @id
  value Int    @default(1)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  timestamp DateTime @default(now())
  details   String
}
